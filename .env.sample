## Django settings
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
WIS2WATCH_DEBUG=False
WAGTAIL_SITE_NAME="Wis2Watch"
LANGUAGE_CODE=en
WIS2WATCH_LOG_LEVEL=WARN
WIS2WATCH_DATABASE_LOG_LEVEL=ERROR

WIS2WATCH_GUNICORN_NUM_OF_WORKERS=4
WIS2WATCH_GUNICORN_TIMEOUT=300

WIS2WATCH_CELERY_BEAT_DEBUG_LEVEL=INFO
WIS2WATCH_CELERY_WORKER_LOG_LEVEL=INFO

## Ingestion
# The Global Broker the ingestion supervisor subscribes to. Seeded as a message
# source on first run; after that, edit it in the admin.
WIS2WATCH_GLOBAL_BROKER_URL=mqtts://everyone:everyone@globalbroker.meteo.fr:8883
# The countries watched, as ISO 3166 alpha-2 codes. Leave empty for all of Africa.
WIS2WATCH_MONITORED_COUNTRIES=
# How often the supervisor re-reads the registry, in seconds. This is the lag
# between a catalogue sync and a newly registered centre being watched.
WIS2WATCH_SUBSCRIPTION_REFRESH_SECONDS=60
# How long the supervisor may back off between attempts at a node's own broker,
# in seconds. Many of these are unreachable from outside, which is recorded as
# a finding rather than retried hard.
WIS2WATCH_ORIGIN_RECONNECT_MAX_SECONDS=3600
# How long between wildcard sweeps of the Global Broker, in seconds. The sweep
# finds centres of the region publishing without a catalogue record, which the
# registry-built subscriptions cannot name.
WIS2WATCH_SWEEP_INTERVAL_SECONDS=3600
# How long one sweep asks for everything, in seconds. Short: while it is
# carried the connection is offered the whole world's traffic.
WIS2WATCH_SWEEP_DURATION_SECONDS=60

## Retention and rollups
# How long raw notification messages are kept, in days. A forensic window, not
# an archive: the permanent record is the hourly rollups, which never expire.
WIS2WATCH_RAW_RETENTION_DAYS=14
# How far back each scheduled rollup run recomputes, in hours. Wide enough that
# a missed run still corrects itself.
WIS2WATCH_ROLLUP_WINDOW_HOURS=48
# How long a centre may be quiet before the node overview calls it stale.
WIS2WATCH_STALE_AFTER_HOURS=24
# How many hourly buckets of traffic the node overview reports as recent volume.
WIS2WATCH_VOLUME_WINDOW_HOURS=24

## Silence baselines
# How much history each dataset's publishing rhythm is learned from, in days.
# Long enough that a daily or weekly dataset has gaps to learn from; anything
# rarer than that is what the per-dataset manual override is for.
WIS2WATCH_CADENCE_WINDOW_DAYS=90
# Which percentile of a dataset's own gaps it is expected to publish within.
WIS2WATCH_CADENCE_PERCENTILE=95
# How many observed gaps a dataset must show before an interval is learned from
# it at all. Below this it is reported as unjudged rather than guessed at.
WIS2WATCH_CADENCE_MIN_OBSERVATIONS=3

## Propagation
# How long a notification seen at a node's own broker is given to reach the
# Global Broker before its absence is recorded as a propagation gap, in minutes.
WIS2WATCH_PROPAGATION_GRACE_MINUTES=15
# How far back each propagation evaluation re-examines, in hours. Clamped to the
# raw retention window whatever this says.
WIS2WATCH_PROPAGATION_WINDOW_HOURS=48

## Database settings
WIS2WATCH_DB_USER=
WIS2WATCH_DB_PASSWORD=
WIS2WATCH_DB_NAME=

## docker volumes
WIS2WATCH_DB_VOLUME=./docker/db_data
WIS2WATCH_STATIC_VOLUME=./docker/static
WIS2WATCH_MEDIA_VOLUME=./docker/media
WIS2WATCH_BACKUP_VOLUME=./docker/backup

## nginx port
WIS2WATCH_WEB_PROXY_PORT=80

# user and group id
UID=
GID=

# use _armv7 if running on ARMv7 architecture. Otherwise leave it empty
DOCKER_COMPOSE_WAIT_PLATFORM_SUFFIX=

# Docker Network Name
# ensure that the network is created before running the docker-compose
# docker network create <network_name>
WIS2WATCH_NETWORK_NAME=